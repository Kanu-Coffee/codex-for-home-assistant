#!/usr/bin/env bash
set -Eeuo pipefail

# Intercept top-level 'update' subcommand to route to managed updater
# and prevent arbitrary self-update from modifying rootfs.
# Prompts that contain the word 'update' (e.g. 'update my lights') are not intercepted.
is_update_subcommand=false
update_args=()
orig_args=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      break
      ;;
    update)
      is_update_subcommand=true
      shift
      update_args=("$@")
      break
      ;;
    -m|--model|-c|--config|-C|--cd|--profile|--color|-s|--sandbox|-p|-a|--ask-for-approval|--enable|--disable|--remote|--remote-auth-token-env|--local-provider|-i|--image|--add-dir)
      shift 2 2>/dev/null || break
      ;;
    -m*|-c*|-C*)
      shift
      ;;
    --model=*|--config=*|--cd=*|--profile=*|--color=*|--sandbox=*|--enable=*|--disable=*|--remote=*|--remote-auth-token-env=*|--local-provider=*|--add-dir=*)
      shift
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ "${is_update_subcommand}" == true ]]; then
  if [[ "${#update_args[@]}" -gt 0 ]]; then
    first_opt="${update_args[0]}"
    case "${first_opt}" in
      status|--status)
        exec /usr/local/bin/ha-codex-update status "${update_args[@]:1}"
        ;;
      check|--check)
        exec /usr/local/bin/ha-codex-update check "${update_args[@]:1}"
        ;;
      apply|--apply)
        exec /usr/local/bin/ha-codex-update apply "${update_args[@]:1}"
        ;;
      -h|--help|help)
        exec /usr/local/bin/ha-codex-update --help
        ;;
      *)
        exec /usr/local/bin/ha-codex-update "${update_args[@]}"
        ;;
    esac
  else
    exec /usr/local/bin/ha-codex-update update
  fi
fi

# Restore positional arguments if update was not intercepted
set -- "${orig_args[@]}"

# Keep config.toml user-owned while applying the current App options to every
# CLI/app-server invocation, including commands launched by Remote SSH.
# shellcheck source=/dev/null
. /usr/local/lib/codex-ha/environment.sh
# shellcheck source=/dev/null
. /usr/local/lib/codex-ha/config.sh
# shellcheck source=/dev/null
. /usr/local/lib/codex-ha/browser-approval.sh
# shellcheck source=/dev/null
. /usr/local/lib/codex-ha/sensitive-path-policy.sh

if ! codex_ha_sensitive_paths_validate /config; then
  printf '%s\n' \
    'codex: protected Home Assistant paths have an unsafe link or file type; Codex will not start' >&2
  exit 78
fi

approval_policy=on-request
sandbox_mode=workspace-write
browser_approval_policy=safe
if codex_ha_config_validate; then
  approval_policy=$(codex_ha_config_string 'codex_approval_policy' 'on-request')
  sandbox_mode=$(codex_ha_config_string 'codex_sandbox_mode' 'workspace-write')
  if ! browser_approval_policy=$(codex_ha_config_string 'browser_approval_policy' 'safe'); then
    printf 'codex: invalid headless browser approval policy\n' >&2
    exit 78
  fi
fi

case "${approval_policy}" in
  untrusted | on-request | never) ;;
  *)
    printf 'codex: invalid App approval policy\n' >&2
    exit 78
    ;;
esac
case "${sandbox_mode}" in
  workspace-write) ;;
  danger-full-access)
    printf '%s\n' \
      'codex: danger-full-access is deprecated and is enforced as workspace-write by the managed sensitive-path policy' >&2
    sandbox_mode=workspace-write
    ;;
  *)
    printf 'codex: invalid App sandbox mode\n' >&2
    exit 78
    ;;
esac
if ! codex_ha_browser_approval_policy_validate "${browser_approval_policy}"; then
  printf 'codex: invalid headless browser approval policy\n' >&2
  exit 78
fi
if ! codex_ha_browser_build_approval_args "${browser_approval_policy}"; then
  printf 'codex: unable to apply headless browser approval policy\n' >&2
  exit 78
fi

# Register active session in runtime maintenance gate to prevent updater apply races
readonly CODEX_MAINTENANCE_GATE=/run/codex-ha/codex-maintenance/gate.lock
readonly CODEX_SESSIONS_DIR=/run/codex-ha/codex-maintenance/sessions

# Default to image baseline binary for resilience
codex_real_bin="/usr/local/libexec/codex-real"

if [[ -d "${CODEX_SESSIONS_DIR}" ]]; then
  if { exec 200>"${CODEX_MAINTENANCE_GATE}"; } 2>/dev/null && timeout 2 flock -s 200 2>/dev/null; then
    start_time=$(awk '{print $22}' "/proc/$$/stat" 2>/dev/null || echo "0")
    # Determine the positional subcommand and its --listen value using the same
    # option-aware skip as the runtime classifier (parseCodexInvocation in
    # codex-runtime-manager.mjs). Option values and post-'--' prompts are never
    # treated as subcommands.
    codex_subcommand=""
    codex_listen=""
    options_ended=false
    idx=0
    args=("$@")
    while [[ "${idx}" -lt "${#args[@]}" ]]; do
      token="${args[${idx}]}"
      if [[ "${options_ended}" == true ]]; then
        idx=$((idx + 1))
        continue
      fi
      if [[ "${token}" != -* ]]; then
        if [[ -z "${codex_subcommand}" ]]; then
          codex_subcommand="${token}"
        fi
      else
        case "${token}" in
          --)
            options_ended=true
            ;;
          --listen=*)
            codex_listen="${token#--listen=}"
            ;;
          -m|--model|-c|--config|-C|--cd|--profile|--color|-s|--sandbox|--add-dir|-p|-a|--ask-for-approval|--enable|--disable|--remote|--remote-auth-token-env|--local-provider|-i|--image)
            idx=$((idx + 1))
            ;;
          --listen)
            if [[ "${codex_subcommand}" == "app-server" ]]; then
              codex_listen="${args[$((idx + 1))]:-}"
            fi
            idx=$((idx + 1))
            ;;
        esac
      fi
      idx=$((idx + 1))
    done
    is_app_server=false
    socket_path=""
    if [[ "${codex_subcommand}" == "app-server" ]]; then
      is_app_server=true
      socket_path="${codex_listen}"
    fi

    session_type="cli"
    managed="false"
    unix_sock=""
    if [[ "${is_app_server}" == true ]]; then
      session_type="app-server"
      if [[ "${socket_path}" == unix://* ]]; then
        managed="true"
        unix_sock="${socket_path#unix://}"
      fi
    fi

    # Resolve the immutable generation and verify its private inventory while
    # holding the admission gate. Never exec through a mutable current symlink.
    if selected_bin=$(/usr/local/bin/ha-codex-update resolve 2>/dev/null); then
      codex_real_bin="${selected_bin}"
    fi
    version_output=$("${codex_real_bin}" --version 2>/dev/null || true)
    selected_version=${version_output#codex-cli }
    if ! jq -n --argjson pid "$$" --arg start "${start_time}" \
      --arg type "${session_type}" --argjson managed "${managed}" \
      --arg socketPath "${unix_sock}" --arg exe "${codex_real_bin}" \
      --arg version "${selected_version}" --arg cwd "${PWD}" \
      --args '{pid:$pid,start:$start,type:$type,managed:$managed,socketPath:$socketPath,exe:$exe,version:$version,cwd:$cwd,args:$ARGS.positional}' \
      -- -c "approval_policy=\"${approval_policy}\"" \
      -c "sandbox_mode=\"${sandbox_mode}\"" \
      -c 'sandbox_workspace_write.network_access=true' \
      --add-dir /data/codex-ha-memory "${CODEX_HA_BROWSER_APPROVAL_ARGS[@]}" "$@" \
      > "${CODEX_SESSIONS_DIR}/$$"; then
      printf '%s\n' 'codex: unable to register session safely' >&2
      exit 78
    fi

    flock -u 200 2>/dev/null || true
    exec 200>&-
  else
    codex_real_bin="/usr/local/libexec/codex-real"
  fi
fi

# Defense in depth: even callers that bypass the normal login-shell profile
# cannot pass the Supervisor credential to Codex or its child processes.
unset SUPERVISOR_TOKEN

if [[ "${codex_real_bin}" != "/usr/local/libexec/codex-real" && -x "${codex_real_bin}" ]]; then
  exec "${codex_real_bin}" \
    -c "approval_policy=\"${approval_policy}\"" \
    -c "sandbox_mode=\"${sandbox_mode}\"" \
    -c 'sandbox_workspace_write.network_access=true' \
    --add-dir /data/codex-ha-memory \
    "${CODEX_HA_BROWSER_APPROVAL_ARGS[@]}" \
    "$@"
fi

exec /usr/local/libexec/codex-real \
  -c "approval_policy=\"${approval_policy}\"" \
  -c "sandbox_mode=\"${sandbox_mode}\"" \
  -c 'sandbox_workspace_write.network_access=true' \
  --add-dir /data/codex-ha-memory \
  "${CODEX_HA_BROWSER_APPROVAL_ARGS[@]}" \
  "$@"
