#!/bin/bash -p
set -Eeuo pipefail

if (( $# != 0 )); then
  printf 'ha-memory-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# shellcheck source=/dev/null
. /usr/local/lib/codex-ha/supervisor-credential.sh
codex_ha_load_supervisor_credential /run/codex-ha/runtime.env || true

memory_env=(
  HOME="${HOME:-/data/home}"
  LANG=C.UTF-8
  LC_ALL=C.UTF-8
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}"
)
readonly TEST_MARKER=/run/codex-ha/allow-memory-test-fixture
readonly TEST_FIXTURE=/tmp/ha-memory-snapshot.json
test_marker_metadata=
if [[ "${HA_MEMORY_TEST_MODE:-}" == 1 \
    && "${HA_MEMORY_TEST_FIXTURE:-}" == "${TEST_FIXTURE}" \
    && ! -L "${TEST_MARKER}" \
    && -f "${TEST_MARKER}" \
    && -r "${TEST_MARKER}" ]] \
  && test_marker_metadata=$(stat -c '%u:%a:%h' -- "${TEST_MARKER}" 2>/dev/null) \
  && [[ "${test_marker_metadata}" == "$(id -u):600:1" ]]; then
  memory_env+=(
    HA_MEMORY_TEST_MODE=1
    HA_MEMORY_TEST_FIXTURE="${TEST_FIXTURE}"
  )
fi
unset HA_MEMORY_TEST_MODE HA_MEMORY_TEST_FIXTURE test_marker_metadata
exec /usr/bin/env -i "${memory_env[@]}" \
  /usr/bin/node /usr/local/share/codex-ha/ha-memory-mcp.mjs
